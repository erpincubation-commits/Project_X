{
  "name": "@erp/desktop", "version": "0.2.0", "private": true,
  "description": "SMB ERP desktop client", "author": "SMB ERP",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.json --noEmit && vite build --configLoader runner",
    "check": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "package:windows": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@erp/contracts": "0.2.0", "react": "^19.0.0", "react-dom": "^19.0.0",
    "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@types/node": "^24.0.0",
    "electron": "^45.3.2", "electron-builder": "^26.0.0", "typescript": "^5.9.0", "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.smberp.desktop", "productName": "SMB ERP",
    "directories": { "output": "../../release" },
    "files": ["dist/**/*", "package.json"],
    "asar": true, "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
