# Server configuration only. The Electron client never receives DATABASE_URL.
# npm run setup generates .env with random passwords when no .env exists.
DATABASE_URL=postgresql://erp_dev:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:55432/erp_dev
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
BOOTSTRAP_ADMIN_EMAIL=admin@local.test
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS
# Optional native PostgreSQL binary directory, when auto-detection is unsuitable:
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
# For an HTTPS reverse proxy deployment only; see docs/DEPLOYMENT.md:
# TLS_PROXY_CONFIRMED=true
